# OpenAI-compatible chat completions endpoint. Groq's free tier is the default.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
LEDGERLY_API_URL=http://localhost:8080
# Seconds to wait for one answer. Raise it for local models.
LLM_TIMEOUT_SECONDS=60
# Where conversations and proposals are kept (SQLite).
ASSISTANT_DB_PATH=assistant.db
# The page that may call the assistant from a browser.
ASSISTANT_ALLOWED_ORIGIN=http://localhost:8080
